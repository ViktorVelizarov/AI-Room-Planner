# Copy this file to .env.local and fill in the values. Never commit .env.local.
# No NEXT_PUBLIC_ prefix on purpose: these stay on the server and never reach the browser.

GEMINI_API_KEY=
# Optional: override the Gemini model (the benchmark used gemini-3.1-pro-preview).
GEMINI_MODEL=gemini-3.1-pro-preview

# Optional: AI calls one browser session may make (default 10). 0 turns AI calls off.
AI_CALL_LIMIT=10

# Optional: how long one layout call may take, in seconds (default 120, from 10 to 150). A layout is longer
# thinking than a detection (which has 60 s), and the first real runs did not finish in 60 s.
GEMINI_LAYOUT_TIMEOUT_S=120
